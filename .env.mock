# Server
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Campaign defaults
CAMPAIGN_DEFAULT_DURATION_DAYS=365
CAMPAIGN_UNLOCK_THRESHOLD=60
CAMPAIGN_PROGRESS_TARGET_PERCENT=50
CAMPAIGN_EXPIRY_RELEASE_MODE=reveal_full_key

# Drop / bidding defaults
DROP_INTERVAL_MINUTES=10
BID_WINDOW_SECONDS=120
MIN_BID=1.00
TIE_BREAK_RULE=earliest_high_bid
MAX_AUTO_BID=50.00

# Token defaults
TOKEN_RARITY_WEIGHTS=common:70,rare:25,epic:5
ALLOW_DUPLICATE_TOKEN_POSSESSION=true
TOKEN_VERIFY_ALGORITHM=Ed25519

# Crypto integration placeholders (from old app later)
CRYPTO_PROVIDER=legacy_app
CRYPTO_API_BASE_URL=http://localhost:4000
CRYPTO_API_KEY=replace_me
CRYPTO_WALLET_SYNC_ENABLED=false

# In-app credits + on-chain deposit policy
DEPOSIT_CREDITS_PER_USD=10
REQUIRED_WALLET_CHAINS=ETH,BTC,SOL,LTC
ETH_REQUIRED_CONFIRMATIONS=12
BTC_REQUIRED_CONFIRMATIONS=2
SOL_REQUIRED_CONFIRMATIONS=32
LTC_REQUIRED_CONFIRMATIONS=6
TREASURY_WALLET_ETH=0x000000000000000000000000000000000000dEaD
TREASURY_WALLET_BTC=bc1qtradeinfotreasury0000000000000000000000
TREASURY_WALLET_SOL=TradeInfoTreasury111111111111111111111111111111
TREASURY_WALLET_LTC=ltc1qtradeinfotreasury0000000000000000000000

# Storage placeholders
PUBLIC_FILE_STORAGE=s3_compatible
PUBLIC_FILE_BASE_URL=https://files.example.com/tradeinfo
